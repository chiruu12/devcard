# DevCard Configuration
# Copy this file to .env and fill in your values

# GitHub token (required for reliable use — 60 req/hr without, 5000 with)
# Create at: https://github.com/settings/tokens (no special scopes needed)
GITHUB_TOKEN=

# Fireworks AI API key (optional — enables --enrich for AI-powered insights)
# Get one at: https://fireworks.ai/
FIREWORKS_API_KEY=
